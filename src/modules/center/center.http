@baseUrl = http://localhost:{{$dotenv PORT}}/api

###  1. SELLER 로그인 
# @name sellerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "seller@example.com",
  "password": "password123"
}

###
@sellerToken = {{sellerLogin.response.body.data.accessToken}}

###  2. 내 센터 조회
# @name myCenter
GET {{baseUrl}}/centers/me
Authorization: Bearer {{sellerToken}}

###
@centerId = {{myCenter.response.body.data.id}}

###  3. 센터 목록 조회 (전체) 
GET {{baseUrl}}/centers

###  4. 센터 목록 조회 (이름 검색) 
GET {{baseUrl}}/centers?name=피트니스

###  5. 센터 목록 조회 (페이지네이션) 
GET {{baseUrl}}/centers?page=1&limit=5

###  6. 센터 상세 조회 
GET {{baseUrl}}/centers/{{centerId}}

###  7. 센터 수정 (센터명 변경) 
PATCH {{baseUrl}}/centers/{{centerId}}
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "name": "수정된 센터명"
}

###  8. 센터 수정 (주소 변경) 
PATCH {{baseUrl}}/centers/{{centerId}}
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "address1": "서울특별시 서초구 서초대로 456",
  "address2": "2층"
}

###  9. 센터 수정 (소개, 영업시간, 좌표 추가) 
PATCH {{baseUrl}}/centers/{{centerId}}
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "introduction": "최신 시설의 프리미엄 피트니스 센터입니다.",
  "businessHours": {
    "mon": "06:00-22:00",
    "tue": "06:00-22:00",
    "wed": "06:00-22:00",
    "thu": "06:00-22:00",
    "fri": "06:00-22:00",
    "sat": "09:00-18:00",
    "sun": "휴무"
  },
  "lat": 37.4979,
  "lng": 127.0276
}

###  10. 센터 수정 (인증 없이 → 401 에러) 
PATCH {{baseUrl}}/centers/{{centerId}}
Content-Type: application/json

{
  "name": "에러 테스트"
}
