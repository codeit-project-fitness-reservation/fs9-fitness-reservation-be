@baseUrl = http://localhost:{{$dotenv PORT}}/api

### 1. ADMIN 로그인
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "test1234"
}

###
@adminToken = {{adminLogin.response.body.data.accessToken}}

### 2. CUSTOMER 로그인
# @name customerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "customer1@test.com",
  "password": "test1234"
}

###
@customerId = {{customerLogin.response.body.data.user.id}}
@customerToken = {{customerLogin.response.body.data.accessToken}}

### 3. SELLER 로그인
# @name sellerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "seller1@test.com",
  "password": "test1234"
}

###
@sellerId = {{sellerLogin.response.body.data.user.id}}
@sellerToken = {{sellerLogin.response.body.data.accessToken}}

### ========== 회원 통계 ==========

### 4. 회원 통계 조회
GET {{baseUrl}}/users/stats
Authorization: Bearer {{adminToken}}

### ========== 회원 목록 ==========

### 5. 회원 목록 조회 (기본)
GET {{baseUrl}}/users
Authorization: Bearer {{adminToken}}

### 6. 회원 목록 조회 (페이지네이션)
GET {{baseUrl}}/users?page=1&limit=5
Authorization: Bearer {{adminToken}}

### 7. 회원 목록 조회 (역할 필터 - CUSTOMER)
GET {{baseUrl}}/users?role=CUSTOMER
Authorization: Bearer {{adminToken}}

### 8. 회원 목록 조회 (역할 필터 - SELLER)
GET {{baseUrl}}/users?role=SELLER
Authorization: Bearer {{adminToken}}

### 9. 회원 목록 조회 (닉네임 검색)
GET {{baseUrl}}/users?searchType=nickname&search=테스트
Authorization: Bearer {{adminToken}}

### 10. 회원 목록 조회 (이메일 검색)
GET {{baseUrl}}/users?searchType=email&search=test
Authorization: Bearer {{adminToken}}

### 11. 회원 목록 조회 (전화번호 검색)
GET {{baseUrl}}/users?searchType=phone&search=010
Authorization: Bearer {{adminToken}}

### ========== 회원 상세 ==========

### 12. 회원 상세 조회 (Admin -> User)
GET {{baseUrl}}/users/{{customerId}}
Authorization: Bearer {{adminToken}}

### 13. 회원 상세 조회 (본인 조회 - Customer)
GET {{baseUrl}}/users/{{customerId}}
Authorization: Bearer {{customerToken}}

### 14. 회원 상세 조회 (타인 조회 시도 - 403 Forbidden)
GET {{baseUrl}}/users/{{sellerId}}
Authorization: Bearer {{customerToken}}

### 15. 회원 상세 조회 (비로그인 - 401 Unauthorized)
GET {{baseUrl}}/users/{{customerId}}

### ========== 회원 메모 (관리자) ==========

### 16. 회원 메모 수정 (관리자)
PATCH {{baseUrl}}/users/{{customerId}}/note
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "note": "매크로 의심"
}

### 17. 회원 메모 삭제 (null로 초기화)
PATCH {{baseUrl}}/users/{{customerId}}/note
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "note": null
}

### ========== 프로필 수정 ==========

### 13. 프로필 수정 - 닉네임 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "nickname": "수정된닉네임"
}

### 14. 프로필 수정 - 연락처 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "phone": "01011118422"
}

### 15. 프로필 수정 - 비밀번호 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{
  "password": "test1234"
}

### 16. 프로필 수정 - 자기소개 변경
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "introduction": "안녕하세요, 10년 경력의 피트니스 트레이너입니다."
}

### 17. 프로필 수정 - 복합 변경 
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{sellerToken}}
Content-Type: application/json

{
  "nickname": "김트레이너",
  "phone": "01033532444",
  "introduction": "전문 트레이너입니다."
}

### 18. 로그아웃 
POST {{baseUrl}}/auth/logout

### 19. 프로필 수정 - 빈 요청 (400 에러)
PATCH {{baseUrl}}/users/me
Authorization: Bearer {{customerToken}}
Content-Type: application/json

{}

### 20. 프로필 수정 - 로그아웃 후 (401 에러)
PATCH {{baseUrl}}/users/me
Content-Type: application/json

{
  "nickname": "에러테스트"
}

